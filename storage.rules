rules_version = '2';

// Brought into the repo 2026-09-07. These rules were console-only until now, so
// nothing reviewed them, nothing tested them, and the only copy lived in a web UI.
//
// The post-images block below is reproduced from the live ruleset
// 346cd647-8175-431f-8076-0623bbfc818a (created 2026-06-23), character for
// character including its comment and spacing. Deploying this file must not
// change the calendar's uploads at all. If that block ever needs editing, diff it
// against that ruleset first.

service firebase.storage {
  match /b/{bucket}/o {
    match /post-images/{allPaths=**} {
      allow read: if true;                                   // public calendar => public images
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // U1 LinkedIn Promotion Programme visuals.
    //
    // Read requires auth here, unlike post-images, and that difference is the
    // whole reason this path exists. These are visuals prepared for a named
    // person's personal post before he has seen it. The Firestore side already
    // restricts that draft copy to signed-in editors, so leaving the matching
    // image world-readable would undo the decision by the back door.
    //
    // The image becomes public the moment he posts it, which is the point of the
    // programme. Until then it is a draft addressed to one man.
    // The path carries the post id, personId_weekOf, because the delete rule
    // below has to find that exact post to read its status. Keying on the person
    // alone would let an image from an approved post be deleted whenever a newer
    // draft existed for the same man, which is the freeze this rule exists to
    // provide.
    match /promo-images/{postId}/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Deletable while the post is still being drafted, frozen once it has left
      // drafting. This mirrors the body, which firestore.rules already freezes at
      // the same moment: once Alex has approved a post for sending, neither the
      // words nor the visual can change underneath that approval.
      //
      // Storage rules can read Firestore, which I did not expect and checked
      // before relying on. The cost is one document read per delete and a hard
      // dependency: if the post document is missing, the delete is refused. That
      // is deliberate. An image whose post cannot be found is not obviously safe
      // to remove, and refusing leaves a visible orphan rather than silently
      // destroying something.
      allow delete: if request.auth != null
                    && firestore.exists(/databases/(default)/documents/promo_posts/$(postId))
                    && firestore.get(/databases/(default)/documents/promo_posts/$(postId)).data.status == 'drafting';
    }
  }
}
