rules_version = '2';

// Brought into the repo 2026-09-07. These rules were console-only until then, so
// nothing reviewed them, nothing tested them, and the only copy lived in a web UI.
//
// The post-images block was originally reproduced character for character from
// live ruleset 346cd647 (created 2026-06-23), with an instruction to diff against
// that ruleset before ever editing it.
//
// That diff was run on 2026-10-07, and the instruction had gone stale. The live
// storage ruleset is 8e272523-562d-464f-8139-3885002a3b0e, created 2026-09-07 by
// the deploy of this very file, and it is byte-identical to what was in the repo.
// So the repo file IS production, 346cd647 is two rulesets back, and the thing to
// diff against is whatever `releases` currently points at rather than a hardcoded
// id. The post-images block was then edited deliberately for video, below.

service firebase.storage {
  match /b/{bucket}/o {
    // Images and video both land here (2026-10-07). The block below was reproduced
    // character for character from live ruleset 346cd647 until today; this is the
    // first deliberate edit to it, and it widens the type and size test rather than
    // touching the auth or read rules. An image still faces exactly the limit it
    // faced before, so nothing that uploaded yesterday stops uploading now.
    //
    // Video types are named rather than matched as video/.* so an editor cannot push
    // a 200MB format the feed will not play. The size split is the whole reason the
    // two arms exist: 10MB is right for a still and absurd for a clip, 200MB is right
    // for a clip and far too loose for a still.
    //
    // PDF carousels joined on 2026-10-25. A LinkedIn carousel is a document post, so
    // its artwork is one PDF. The type is matched exactly, and 100MB is LinkedIn's own
    // document ceiling (Documents API page on Microsoft Learn, checked 2026-10-25).
    // The programme path below stays image-only.
    match /post-images/{allPaths=**} {
      allow read: if true;                                   // public calendar => public images
      allow write: if request.auth != null
                   && (
                        (request.resource.contentType.matches('image/.*')
                         && request.resource.size < 10 * 1024 * 1024)
                     || (request.resource.contentType.matches('video/(mp4|quicktime|webm)')
                         && request.resource.size < 200 * 1024 * 1024)
                     || (request.resource.contentType == 'application/pdf'
                         && request.resource.size < 100 * 1024 * 1024)
                      );
    }

    // U1 LinkedIn Promotion Programme visuals.
    //
    // Read requires auth here, unlike post-images, and that difference is the
    // whole reason this path exists. These are visuals prepared for a named
    // person's personal post before he has seen it. The Firestore side already
    // restricts that draft copy to signed-in editors, so leaving the matching
    // image world-readable would undo the decision by the back door.
    //
    // The image becomes public the moment he posts it, which is the point of the
    // programme. Until then it is a draft addressed to one man.
    // The path carries the post id, personId_weekOf, because the delete rule
    // below has to find that exact post to read its status. Keying on the person
    // alone would let an image from an approved post be deleted whenever a newer
    // draft existed for the same man, which is the freeze this rule exists to
    // provide.
    match /promo-images/{postId}/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Deletable while the post is still being drafted, frozen once it has left
      // drafting. This mirrors the body, which firestore.rules already freezes at
      // the same moment: once Alex has approved a post for sending, neither the
      // words nor the visual can change underneath that approval.
      //
      // Storage rules can read Firestore, which I did not expect and checked
      // before relying on. The cost is one document read per delete and a hard
      // dependency: if the post document is missing, the delete is refused. That
      // is deliberate. An image whose post cannot be found is not obviously safe
      // to remove, and refusing leaves a visible orphan rather than silently
      // destroying something.
      allow delete: if request.auth != null
                    && firestore.exists(/databases/(default)/documents/promo_posts/$(postId))
                    && firestore.get(/databases/(default)/documents/promo_posts/$(postId)).data.status == 'drafting';
    }
  }
}
