rules_version = '2';

/* u1-calendar Firestore rules.

   The first four blocks are the calendar app rules. The proposals block carries the
   l2 review-stage protection added with the brand gate (calendar-v3.0, 2026-08-10):
   an editor can never mark their own post reviewed. The reviews block is the brand
   gate's review-feedback store, same date. The newsletter_events block is the
   newsletter analytics addition (July 2026) and is deliberately untouched here.
   Deploying this file replaces ALL Firestore rules in the project: merge, never
   overwrite, and keep every block accounted for. */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---- Who may write, 2026-08-31 ----
       Read access to the board stays open on purpose: leadership glances at it
       without signing in, and a login wall was rejected as friction. WRITE access
       was the real hole. Until now isEditor was literally "is signed in", so any
       Google account that found the URL could create a proposal in this calendar.
       The owner stays hardcoded so a bad roles document can never lock him out. */
    function isOwnerEmail() {
      return request.auth != null
             && request.auth.token.email == "wakroz@gmail.com";
    }
    function isApprovedEditor() {
      return isOwnerEmail()
             || (request.auth != null
                 && exists(/databases/$(database)/documents/config/roles)
                 && request.auth.token.email in
                    get(/databases/$(database)/documents/config/roles).data.editors);
    }

    // ---- The editor allowlist. Owner edits it in the console; no deploy needed. ----
    match /config/roles {
      allow read:  if request.auth != null;
      allow write: if isOwnerEmail();
    }

    // ---- The one published calendar everyone sees ----
    match /calendar/live {
      allow read: if true;                                              // public read
      allow write: if request.auth != null
                   && request.auth.token.email == "wakroz@gmail.com";   // only owner publishes
    }

    // ---- Append-only version history of published calendars (owner-only) ----
    match /calendar_versions/{id} {
      allow read:           if request.auth != null
                            && request.auth.token.email == "wakroz@gmail.com";
      allow create, delete: if request.auth != null
                            && request.auth.token.email == "wakroz@gmail.com";
      // no update: history is append-only
    }

    // ---- In-app notifications ----
    // Owner creates approval notices to a proposer; any signed-in editor may
    // create a notice addressed to the owner role (submitted for approval).
    match /notifications/{id} {
      allow read:           if request.auth != null
                            && (resource.data.toUid == request.auth.uid
                                || request.auth.token.email == "wakroz@gmail.com");
      allow create:         if request.auth != null
                            && (request.auth.token.email == "wakroz@gmail.com"
                                || request.resource.data.toRole == "owner");
      allow update, delete: if request.auth != null
                            && (resource.data.toUid == request.auth.uid
                                || request.auth.token.email == "wakroz@gmail.com");
    }

    // ---- Each signed-in user's own working draft (doc id = their Firebase uid) ----
    // l1 is set by the client gate and is the editor's to write.
    // l2 is the review stage and is NOT the editor's to write, otherwise an
    // editor could mark their own post reviewed and skip the judgement pass.
    // Brand-gate enforcement (2026-08-11): a proposal may not be marked submitted
    // unless the Level-1 gate passed it (l1 == 'clean'). This is the server-side
    // half of the gate: it survives devtools, a stale script, and a gate that
    // failed to load. The owner keeps the override, and every override is logged
    // to /overrides below.
    function gatePassed() {
      return !('submitted' in request.resource.data)
             || request.resource.data.submitted != true
             || request.resource.data.l1 == 'clean';
    }

    match /proposals/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.token.email == "wakroz@gmail.com");

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isApprovedEditor()
                    && gatePassed()
                    && (!('l2' in request.resource.data)
                        || request.resource.data.l2 == 'pending');

      allow update: if request.auth != null
                    && (
                         request.auth.token.email == "wakroz@gmail.com"
                         || (request.auth.uid == uid
                             && isApprovedEditor()
                             && gatePassed()
                             && (
                                  // A write that omits l2 resets the post to
                                  // unreviewed, which is true the moment content
                                  // changes. Editors still can never SET a value,
                                  // so faking "reviewed" stays impossible. The
                                  // stricter both-absent form deadlocked editors
                                  // after the runner stamped done (2026-08-18).
                                  (!('l2' in request.resource.data))
                                  || (('l2' in request.resource.data) && ('l2' in resource.data)
                                      && request.resource.data.l2 == resource.data.l2)
                                  || (!('l2' in resource.data)
                                      && request.resource.data.l2 == 'pending')
                                )
                            )
                       );

      allow delete: if request.auth != null
                    && (request.auth.uid == uid
                        || request.auth.token.email == "wakroz@gmail.com");

      // ---- One document per post (step 1 of the per-post migration) ----
      //
      // Today a save rewrites this editor's entire calendar copy: 140 KB measured
      // on a real draft, every 800ms of typing. Two editors working on two
      // different posts still write the same document, so safety comes from the
      // merge being careful rather than from the writes never colliding.
      //
      // A unit is one scheduled post, one lane post, or one event, keyed the way
      // U1Scope.allKeyedUnits keys them. Two people on different posts then write
      // different documents and cannot clobber each other at all, and a save
      // drops from 140 KB to about 1 KB.
      //
      // Nothing reads these yet. The shape ships before any client writes it, and
      // it rolls back by simply not writing them. Access is exactly the parent's:
      // the editor who owns the proposal, and the owner. An editor removed from
      // the allowlist loses these writes at the same moment they lose the parent.
      match /units/{unitKey} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || request.auth.token.email == "wakroz@gmail.com");

        allow write: if request.auth != null
                     && (
                          request.auth.token.email == "wakroz@gmail.com"
                          || (request.auth.uid == uid && isApprovedEditor())
                        );
      }
    }

    // ---- Brand-gate review feedback (calendar-v3.0; reshaped 2026-08-18) ----
    // Three writers, one collection:
    //   reviewer == "auto"   : the Level-1 gate, running client-side as the editor,
    //                          writes its own findings about the editor's own submission.
    //                          One document per editor (id "auto_<uid>"), REPLACED on
    //                          every submit, so stale findings from earlier attempts
    //                          never accumulate. The editor rewriting their own auto
    //                          review is by design: the findings are derived state the
    //                          gate regenerates, and the tamper-proof record of what
    //                          was pushed through anyway lives in /overrides.
    //   reviewer == "alex"   : the owner adds Level-2 judgement notes.
    //   reviewer == "claude" : written by the Admin SDK service account, which
    //                          bypasses these rules entirely. Listed for documentation.
    // An editor may never touch a review that is not their own auto review, may not
    // re-address one, and may not change who it claims to be from.
    match /reviews/{id} {
      allow read:   if request.auth != null
                    && (resource.data.toUid == request.auth.uid
                        || request.auth.token.email == "wakroz@gmail.com");

      allow create: if request.auth != null
                    && (
                         request.auth.token.email == "wakroz@gmail.com"
                         || (request.resource.data.reviewer == "auto"
                             && request.resource.data.toUid == request.auth.uid)
                       );

      // Editor: full rewrite of their own auto review only (the gate replacing its
      // own findings, or ticking items done). Owner may update anything.
      allow update: if request.auth != null
                    && (
                         request.auth.token.email == "wakroz@gmail.com"
                         || (resource.data.toUid == request.auth.uid
                             && resource.data.reviewer == "auto"
                             && request.resource.data.reviewer == "auto"
                             && request.resource.data.toUid == request.auth.uid)
                       );

      allow delete: if request.auth != null
                    && request.auth.token.email == "wakroz@gmail.com";
    }

    // ---- Brand-gate override audit (2026-08-11) ----
    // Written when someone pushes a blocked post through anyway. Immutable by
    // design: an override is a decision on the record, not a draft.
    match /overrides/{id} {
      allow read:   if request.auth != null
                    && request.auth.token.email == "wakroz@gmail.com";
      allow create: if request.auth != null
                    && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    // ---- Newsletter engagement events (ADDED for July 2026 analytics) ----
    // Append-only. Readers write one small document per page or section view.
    // No personal data is accepted: the schema is closed to exactly these eight
    // fields, so an email address cannot be smuggled in even by a modified client.
    // Reads are open because the collection holds counts and anonymous UUIDs only.
    match /newsletter_events/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                         ['issue','type','section','visitor','device','ref','ts','ext_host'])
                    && request.resource.data.issue is string
                    && request.resource.data.issue.size() <= 16
                    && request.resource.data.type in ['issue_view','section_view']
                    && request.resource.data.section is string
                    && request.resource.data.section.size() <= 40
                    && request.resource.data.visitor is string
                    && request.resource.data.visitor.size() <= 64
                    && request.resource.data.device in ['mobile','desktop']
                    && request.resource.data.ref in
                         ['direct','internal','outlook','external','unknown']
                    && request.resource.data.ts is timestamp
                    // ext_host is optional: only present on an 'external' referrer,
                    // and only ever a bare hostname, never a full URL.
                    && (!('ext_host' in request.resource.data)
                        || (request.resource.data.ext_host is string
                            && request.resource.data.ext_host.size() <= 60));

      // History is immutable: no edits, no deletes.
      allow update, delete: if false;
    }

    // ---- Website-direction voting (RESTORED 2026-08-25) ----
    // This block existed ONLY in the deployed ruleset, not in this file, so the
    // 2026-08-25 restore had to merge it back in by hand. Any rules deploy on
    // this project must carry EVERY block in this file: on 2026-08-25 an older
    // rules file was deployed and silently wiped reviews, overrides, and the
    // proposals gate floor for about an hour. Verify with verify_rules.py.
    match /direction_votes/{voter} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
                                 ['voter','choice','name','note','device','ts'])
                            && request.resource.data.voter == voter
                            && request.resource.data.voter.size() <= 64
                            && request.resource.data.choice in [
                                 'beneath_v1','beneath_v2',
                                 'overdeliver_v1','overdeliver_v2',
                                 'command_v1','command_v2',
                                 'showcase_v1','showcase_v2',
                                 'hive_v1','hive_v2',
                                 'road_v1','road_v2']
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.note is string
                            && request.resource.data.note.size() <= 280
                            && request.resource.data.device in ['mobile','desktop']
                            && request.resource.data.ts is timestamp;
      allow delete: if false;
    }

    // ---- U1 LinkedIn Promotion Programme (2026-09-07) ----
    //
    // A deliberately separate surface. These posts publish to named individuals'
    // PERSONAL LinkedIn profiles, not to U1 pages, so the brand gate does not
    // apply to them and the programme page never loads u1_gate.js.
    //
    // The locked ruling behind that, from project-u1-foremen-linkedin-program:
    // "These are personal pages, so the U1 Main voice recipe, the B2B end-user
    // prohibition and the brand-line rules do NOT apply wholesale." Applying the
    // U1 gate here would demand the U1 signature and U1 hashtags on a man's own
    // page, and would flag one editor's own habitual phrasing as an AI-tell.
    //
    // Read is closed, unlike the calendar. The calendar is open to read by
    // decision because leadership needs it without signing in; this holds draft
    // copy written for named people before they have seen it, which is nobody
    // else's business.
    match /promo_people/{personId} {
      allow read:  if isApprovedEditor();
      allow write: if isOwnerEmail();
    }

    // The approval flow, enforced here rather than only in the page.
    //
    // The team drafts, Alex approves it for sending, it goes to Denis, Denis
    // coordinates with his people and comes back with one verdict, then we post.
    // Denis Mezheretskov is Senior Director of Construction Field Services and
    // the men in the roster report through him, so his verdict covers the
    // roster and the coordination behind it is his.
    //
    // Putting this in the UI alone would make it decoration. The calendar
    // learned that in August: the gate lived client-side and an editor's own
    // submission never met it, so the server rule is what actually holds.
    //
    // Four states plus a terminal branch:
    //   drafting    the team is writing it. Editors may edit freely here.
    //   with_alex   sent up for approval. Only Alex moves it on.
    //   with_denis  a review link exists and it is with Denis. The link is minted
    //               and this state is set in one action, so the state cannot claim
    //               it is with Denis when no link exists.
    //   needs_edits Denis wants changes. Goes back to the editor who submitted it,
    //               who may edit again from here. Added 2026-09-09.
    //   approved    the man said yes. Not up on his profile yet. Added 2026-09-09.
    //   posted_claimed  an editor says it is live on his page. Not yet checked by
    //               Alex. Added 2026-09-09.
    //   posted      Alex checked the profile and it is live.
    //   declined    an outright no. No reason required.
    function promoState(d) {
      return ('status' in d) ? d.status : 'drafting';
    }
    /* Where an editor may still change the words. needs_edits is here because Denis
       asked for changes and the post goes back to the person who submitted it; if
       they could not edit from that state the loop would need Alex for every round
       trip [SOURCE: user 2026-09-09]. */
    function promoEditableStates() {
      return ['drafting', 'needs_edits'];
    }
    /* Readable by anyone with the link. 'approved' is the man's yes, so from that
       moment the closed read has nothing left to protect: he has read the words and
       agreed to them. 'posted' means we have seen them live on his profile, so they
       are public already.

       with_denis is deliberately NOT here. At that point the post is in flight and
       nobody has answered, which is exactly what the closed read exists for.
       'declined' is not here either; a man's no is his own business.

       Mirrors PUBLIC_STATES in u1_promotion_programme.html. */
    function promoPublicStates() {
      return ['approved', 'posted_claimed', 'posted'];
    }

    /* Review links, added 2026-09-09.

       Denis has no account and will not sign in. That is the same premise the split
       read was built on. So the only way he reviews a post is a link whose secret IS
       the credential: the document id is random and unguessable, and holding it is
       what grants access.

       WHAT IS EXPOSED, and it is deliberately small. This document carries a SNAPSHOT
       of one post, not a pointer into promo_posts. The real record stays closed the
       whole time. A leaked link therefore reveals one post and lets someone answer on
       that one post, rather than opening the collection.

       WHAT DENIS MAY WRITE. Only his answer, and only once. He sets response, comment
       and respondedAt, and he cannot touch the snapshot, the post id, or a response
       he has already given. Alex reads the answer on the board and moves the real
       post himself, so the state change on a man's profile copy is always made by an
       authenticated owner rather than by a token [SOURCE: user 2026-09-09].

       REVOCATION is deleting the document, which only the owner can do.

       The honest limit: anyone holding the link can answer as Denis. That is inherent
       to a no-login link and it was accepted knowingly. It is bounded to one post. */
    match /review_links/{token} {
      /* get and list are split, and the split is the whole security of this.

         `allow read` covers BOTH, so a single open read let anyone enumerate the
         collection with no credential at all and lift every outstanding review: the
         post body, the man's name and title, and the image URL. Verified against
         production 2026-09-09, HTTP 200 on an unauthenticated list.

         That is the same get-versus-list distinction this file already applies to
         promo_posts, written into the commit that created this block and then not
         applied to the block itself. Caught by the second read.

         get stays open, because knowing the unguessable id is the credential and that
         is the entire mechanism. list is the owner's, which matches actual use:
         watchVerdicts only ever runs for the owner. */
      allow get:  if true;
      allow list: if isOwnerEmail();

      // Only Alex mints or revokes a link.
      allow create, delete: if isOwnerEmail();

      // Denis answers. He may set only his answer, only on a link that has none yet,
      // and he may not alter the snapshot he was shown.
      allow update: if isOwnerEmail()
                    || (
                         !('response' in resource.data)
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['response', 'comment', 'respondedAt'])
                         && request.resource.data.response in ['approved', 'edits']
                       );
    }

    match /promo_posts/{postId} {
      /* Split read, decided 2026-09-09.

         The calendar is open to read with no sign-in wall, on the ruling that a CEO
         will not sign in to look at a board. This page held the opposite posture,
         closed to everyone but editors, because it carries draft copy written for
         named people before they have seen it. Both rulings stand, so the read
         splits by state rather than one of them giving way.

         Three states open, and each for its own reason. 'approved' is the man's yes,
         so the closed read has nothing left to protect. 'posted_claimed' and 'posted'
         mean the words are on his public profile already.

         Everything else stays shut, including 'with_denis'. At that point the drafts
         are in flight to the men and none of them has answered yet, so it is exactly
         the case the closed read exists for. 'declined' stays shut too: a man's no is
         his own business.

         Note for anyone reading this from the client: a collection query that COULD
         return a denied document is refused outright, so an anonymous reader cannot
       They have to query where status is in promoPublicStates(). */
      allow read: if isApprovedEditor()
                  || promoState(resource.data) in promoPublicStates();

      // A new post always starts in drafting. Nobody creates one already approved.
      allow create: if isApprovedEditor()
                    && promoState(request.resource.data) == 'drafting';

      /* An editor has exactly two jobs here, and they are separated on purpose.

         WRITING. From drafting or needs_edits they may keep working or hand it up to
         Alex. Once Alex has it, or Denis has it, the body freezes, so an approval can
         never be attached to different words than the ones that were approved.

         REPORTING IT LIVE. From approved, and only from approved, they may say it has
         gone up. Only the status moves; the words cannot change in the same write.

         Keeping those separate matters more than it looks. posted_claimed is a public
         state. If an editor could reach it from drafting, they could publish a man's
         copy to anyone with the link without Denis ever seeing it. */
      allow update: if isOwnerEmail()
                    || (
                         isApprovedEditor()
                         && (
                              (
                                promoState(resource.data) in promoEditableStates()
                                // needs_edits is a target as well as a source: an editor
                                // working through Denis's comments saves as they go, and
                                // hands it up when it is ready.
                                && promoState(request.resource.data) in ['drafting', 'with_alex', 'needs_edits']
                              )
                              ||
                              (
                                promoState(resource.data) == 'approved'
                                && promoState(request.resource.data) == 'posted_claimed'
                                && request.resource.data.diff(resource.data).affectedKeys()
                                     .hasOnly(['status', 'updatedBy', 'updatedAt'])
                              )
                            )
                       );

      allow delete: if isOwnerEmail();
    }
  }
}
